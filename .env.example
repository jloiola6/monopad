# MonoPad listens only on loopback. Tailscale Serve supplies private HTTPS.
MONOPAD_HOST=127.0.0.1
MONOPAD_PORT=8787

# Create with: npm run token
MONOPAD_ACCESS_TOKEN=replace-with-a-long-random-token

# Official MonoCode Host (recommended). Token remains on this PC.
MONOCODE_HOST_URL=http://127.0.0.1:3774
MONOCODE_DEVICE_TOKEN=replace-with-the-device-token-from-monocode-host-pair

# Optional: use demo data without a running MonoCode Host.
MONOPAD_DEMO=false
